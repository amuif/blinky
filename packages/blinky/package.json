{
	"name": "blinky-avatar",
	"version": "0.1.0",
	"description": "A drop-in web component that turns any user into a cute, animated avatar.",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist",
		"svelte"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/blinky.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./svelte": {
			"types": "./svelte/index.d.ts",
			"svelte": "./svelte/index.js",
			"default": "./svelte/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vite build && vite build -c vite.react.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"dev": "vite",
		"size": "size-limit"
	},
	"devDependencies": {
		"@size-limit/file": "^14.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"size-limit": "^14.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"unpkg": "./dist/blinky.iife.js",
	"jsdelivr": "./dist/blinky.iife.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"web-component",
		"avatar",
		"custom-element"
	],
	"size-limit": [
		{
			"path": "dist/blinky.iife.js",
			"limit": "10 kB",
			"gzip": true
		}
	],
	"peerDependencies": {
		"react": ">=18",
		"svelte": ">=5"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
