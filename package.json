{
	"name": "blinky-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"dev": "pnpm --filter blinky-avatar dev",
		"lint": "biome check .",
		"format": "biome check --write .",
		"bench": "turbo run bench",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build && changeset publish",
		"size": "turbo run size",
		"landing": "pnpm --filter blinky dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@changesets/cli": "^3.0.3",
		"turbo": "^2.11.13",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.23.0"
}
